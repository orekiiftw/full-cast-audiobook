# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/audiobook

# Redis connection string (required — the durable pipeline queue runs on
# BullMQ/Redis). Quickest local option: docker run -d -p 6379:6379 redis:7
# For anything beyond a single machine, enable AOF persistence
# (appendonly yes) so queued work survives a Redis restart; the boot
# recovery re-enqueues from Postgres either way.
REDIS_URL=redis://127.0.0.1:6379

# Pipeline worker concurrency (optional)
# MAX_WORKERS_PER_BOOK=3   # concurrent segment synthesis jobs per instance
# INGESTION_CONCURRENCY=2  # concurrent book ingestions (EPUB download + parse)
# STITCH_CONCURRENCY=2     # concurrent chapter stitches (ffmpeg)

# Server bind address (default: 127.0.0.1 — the API requires an authenticated
# session cookie, but the signup/login endpoints are still public; only expose
# beyond loopback if you know what you're doing)
HOST=127.0.0.1
# Port (default: 3000)
PORT=3000

# Session cookies are Secure-only when NODE_ENV=production. Set this ONLY for
# trusted plain-HTTP deployments (e.g. a LAN appliance without TLS) — never on
# the public internet.
# INSECURE_HTTP=true

# Optional: allow ONE external origin to call the API cross-origin
# (the SPA is served same-origin, so this is normally unnecessary)
# CORS_ORIGIN=https://your-frontend.example.com

# --- Account & session hardening ---

# New-account registration is CLOSED by default. Set to true to create your
# own account(s), then remove it (or set false) so that exposing the server
# beyond loopback does not let strangers sign up and spend your API quota.
# REGISTRATION_ENABLED=true

# Absolute cap on a session's lifetime in ms (bounded above by the 30-day
# rolling TTL). A stolen cookie stops being honored once it is older than
# this, regardless of activity. Leave unset for the default 30-day window,
# or shorten it (e.g. 28800000 = 8h, 86400000 = 1d) for a stricter policy.
# SESSION_MAX_AGE_MS=2592000000


# Google Gemini (required for emotional beat annotation)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Xiaomi MiMo TTS (required for speech synthesis)
# Docs: https://mimo.mi.com/docs/usage-guide/speech-synthesis-v2.5
# Keys: https://platform.xiaomimimo.com/console/api-keys
MIMO_API_KEY=
MIMO_TS_MODEL=mimo-v2.5-tts
MIMO_TS_BASE_URL=https://api.xiaomimimo.com/v1

# TorBox (required for torrent search / download)
TORBOX_API_KEY=

# Cloudflare R2 (optional — falls back to ./.storage/ if unset)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
