# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/audiobook

# Redis connection string (required — the durable pipeline queue runs on
# BullMQ/Redis). Quickest local option: docker run -d -p 6379:6379 redis:7
# For anything beyond a single machine, enable AOF persistence
# (appendonly yes) so queued work survives a Redis restart; the boot
# recovery re-enqueues from Postgres either way.
REDIS_URL=redis://127.0.0.1:6379

# Pipeline worker concurrency (optional)
# MAX_WORKERS_PER_BOOK=3   # concurrent segment synthesis jobs per instance
# INGESTION_CONCURRENCY=2  # concurrent book ingestions (EPUB download + parse)
# STITCH_CONCURRENCY=2     # concurrent chapter stitches (ffmpeg)
# TTS_MAX_CONCURRENCY=3    # in-flight TTS API calls per instance across all books (default: MAX_WORKERS_PER_BOOK)

# Voicing window (optional): segments synthesized ahead of the listener's
# current segment, across chapter ends. The rest wait until playback gets close.
# LOOKAHEAD_SEGMENTS=4

# Server bind address (default: 127.0.0.1 — the API requires an authenticated
# session cookie, but the signup/login endpoints are still public; only expose
# beyond loopback if you know what you're doing)
HOST=127.0.0.1
# Port (default: 3000)
PORT=3000

# Session cookies are always Secure-only, so browsers send them over HTTPS
# (Chrome and Firefox also accept them on http://localhost). Set this ONLY for
# trusted plain-HTTP deployments (e.g. a LAN appliance without TLS) — never on
# the public internet.
# INSECURE_HTTP=true

# Optional: allow ONE external origin to call the API cross-origin
# (the SPA is served same-origin, so this is normally unnecessary)
# CORS_ORIGIN=https://your-frontend.example.com

# Behind a reverse proxy (Caddy, nginx, Railway's edge): read the client IP from
# X-Forwarded-For and the original scheme from X-Forwarded-Proto (used by the
# CSRF origin check and HSTS). The proxy MUST overwrite both headers, and the
# server must not be reachable except through it. TRUST_PROXY_HOPS is the
# number of proxies in front of the server (default 1).
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1

# "production" makes DATABASE_URL mandatory (no local fallback) and enables the
# production security warnings at boot. The Docker image sets it.
# NODE_ENV=production

# --- Account & session hardening ---

# New-account registration is CLOSED by default. Set to true to create your
# own account(s), then remove it (or set false) so that exposing the server
# beyond loopback does not let strangers sign up and spend your API quota.
# REGISTRATION_ENABLED=true

# Absolute cap on a session's lifetime in ms (bounded above by the 30-day
# rolling TTL). A stolen cookie stops being honored once it is older than
# this, regardless of activity. Leave unset for the default 30-day window,
# or shorten it (e.g. 28800000 = 8h, 86400000 = 1d) for a stricter policy.
# SESSION_MAX_AGE_MS=2592000000


# Google Gemini (required for emotional beat annotation)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Xiaomi MiMo TTS (required for speech synthesis)
# Docs: https://mimo.mi.com/docs/usage-guide/speech-synthesis-v2.5
# Keys: https://platform.xiaomimimo.com/console/api-keys
MIMO_API_KEY=
MIMO_TS_MODEL=mimo-v2.5-tts
MIMO_TS_BASE_URL=https://api.xiaomimimo.com/v1

# Sarvam AI Bulbul TTS (required for Hindi and the other Indic scripts MiMo cannot pronounce).
# Books detected as Indic are voiced by this provider; English books keep using MiMo.
# Docs: https://docs.sarvam.ai/api-reference-docs/text-to-speech/convert
# Keys: https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional: "bulbul:v3" (default, has pace + temperature) or "bulbul:v2" (legacy)
# SARVAM_TS_MODEL=bulbul:v3
# SARVAM_TS_BASE_URL=https://api.sarvam.ai
# Optional: narrator speaker. bulbul:v3 voices include shubh, priya, ritu, kavya, aditya, rohan.
# SARVAM_TS_SPEAKER=shubh
# Optional: global narration rate. 0.9 = 10% slower everywhere; beat pacing scales around it.
# SARVAM_TS_PACE=1
# Optional: force one provider for every book ("sarvam" or "mimo") instead of language routing
# TTS_PROVIDER=

# Acquisition ranking policy. PREFERRED_LANGUAGES defaults to "en". A book that exists in
# several languages is titled the same in each, so an edition in the wrong language can
# outrank the one you meant — list the languages you actually want, best first.
# PREFERRED_LANGUAGES=hi,gu,en
# PREFERRED_FORMATS=epub

# Acquisition providers, comma-separated. Available: torrent, archive-org,
# gutenberg, libgen, anna-archive (anna-archive is a fail-closed stub; leave it off).
# BOOK_PROVIDERS_ENABLED=torrent,archive-org,gutenberg,libgen
# Provider search cache lifetime in ms (default 1h, 60000..604800000) and result cap (default 25, max 100)
# BOOK_SEARCH_CACHE_TTL_MS=3600000
# BOOK_SEARCH_MAX_RESULTS=25

# TorBox (required for torrent search / download)
TORBOX_API_KEY=
# TORBOX_SEARCH_URL=https://search-api.torbox.app

# Optional self-hosted book catalogue: torrent candidate search needs both
# values; downloads from its IPFS node need the URL (the token is sent as a
# Bearer header when set).
# CATALOGUE_BASE_URL=https://catalogue.example.com
# CATALOGUE_TOKEN=

# Cloudflare R2 (optional — falls back to ./.storage/ if unset)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
